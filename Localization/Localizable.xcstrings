      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun élément d’ouverture."
          }
        }
      }
    },
    "No other app installed a launch agent or daemon.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune autre app n’a installé d’agent ou de démon."
          }
        }
      }
    },
    "Nothing has changed yet. Each change can be undone later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a encore changé. Chaque modification pourra être annulée."
