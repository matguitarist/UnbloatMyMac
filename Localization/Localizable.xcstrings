{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ can be freed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ à libérer"
          }
        }
      }
    },
    "%@ does this too": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ le fait aussi"
          }
        }
      }
    },
    "%@ restart, so the screen may flicker.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ redémarrent, l’écran peut clignoter."
          }
        }
      }
    },
    "%lld advanced tweaks stop system services and are hidden.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld réglages avancés arrêtent des services système et sont masqués."
          }
        }
      }
    },
    "%lld changes applied.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld modifications appliquées."
          }
        }
      }
    },
    "%lld items": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld éléments"
          }
        }
      }
    },
    "%lld of %lld allowed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sur %lld autorisés"
          }
        }
      }
    },
    "%lld of %lld applied": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sur %lld appliqués"
          }
        }
      }
    },
    "%lld of %lld installed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sur %lld installés"
          }
        }
      }
    },
    "%lld tweaks you applied are back to how macOS had them. Apply them again?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld réglages que vous aviez appliqués sont revenus à l’état de macOS. Les appliquer de nouveau ?"
          }
        }
      }
    },
    "1 advanced tweak stops a system service and is hidden.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 réglage avancé arrête un service système et est masqué."
          }
        }
      }
    },
    "1 change applied.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 modification appliquée."
          }
        }
      }
    },
    "1 item": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 élément"
          }
        }
      }
    },
    "1 left": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 restant"
          }
        }
      }
    },
    "About Homebrew": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos de Homebrew"
          }
        }
      }
    },
    "Accent color": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleur d’accentuation"
          }
        }
      }
    },
    "Add Full Windows Preset": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter le préréglage Windows complet"
          }
        }
      }
    },
    "Add Preset": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un préréglage"
          }
        }
      }
    },
    "Add Task": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter"
          }
        }
      }
    },
    "Add a set of tweaks to your changes. You review everything before it applies.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un ensemble de réglages à vos modifications. Vous vérifiez tout avant application."
          }
        }
      }
    },
    "Add to Changes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter aux modifications"
          }
        }
      }
    },
    "Adds one line to ~/.zshrc, inside a block UnbloatMyMac marks. Turn off to take it out.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une ligne à ~/.zshrc, dans un bloc marqué par UnbloatMyMac. Désactivez pour la retirer."
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancé"
          }
        }
      }
    },
    "After log out": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après déconnexion"
          }
        }
      }
    },
    "All %lld applied": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld sont appliqués"
          }
        }
      }
    },
    "Allow %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser %@"
          }
        }
      }
    },
    "Allow this item to run again": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser de nouveau cet élément"
          }
        }
      }
    },
    "Also adds the Finder, typing, and window tweaks that make the Mac feel like Windows": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute aussi les réglages du Finder, de la saisie et des fenêtres qui donnent au Mac l’allure de Windows"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparence"
          }
        }
      }
    },
    "Apple Intelligence tweaks": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages Apple Intelligence"
          }
        }
      }
    },
    "Applied": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqué"
          }
        }
      }
    },
    "Applied %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ appliqué"
          }
        }
      }
    },
    "Apply Changes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer les modifications"
          }
        }
      }
    },
    "Applying…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Application…"
          }
        }
      }
    },
    "Approve in System Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À approuver dans Réglages Système"
          }
        }
      }
    },
    "Approve “UnbloatMyMac: Apple Intelligence” in System Settings > General > Device Management.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuvez « UnbloatMyMac: Apple Intelligence » dans Réglages Système > Général > Gestion des appareils."
          }
        }
      }
    },
    "Background Items": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éléments en arrière-plan"
          }
        }
      }
    },
    "Caches, leftovers, and developer files that can safely go. Files move to the Trash; empty it to free the space.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, restes et fichiers de développement dont vous pouvez vous passer. Les fichiers vont dans la corbeille ; videz-la pour libérer l’espace."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        }
      }
    },
    "Categories": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Catégories"
          }
        }
      }
    },
    "Change this item in System Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier cet élément dans Réglages Système"
          }
        }
      }
    },
    "Changes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifications"
          }
        }
      }
    },
    "Changes show at once. Turn off to see them after you log out.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications sont visibles tout de suite. Désactivez pour les voir après déconnexion."
          }
        }
      }
    },
    "Changes you apply show here, and you can undo all of them at once.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications appliquées s’affichent ici, et vous pouvez toutes les annuler d’un coup."
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher des mises à jour…"
          }
        }
      }
    },
    "Choose a tweaks file saved by UnbloatMyMac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier de réglages enregistré par UnbloatMyMac."
          }
        }
      }
    },
    "Clean": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyer"
          }
        }
      }
    },
    "Clean %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyer %@"
          }
        }
      }
    },
    "Clean %@?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyer %@ ?"
          }
        }
      }
    },
    "Clean…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyer…"
          }
        }
      }
    },
    "Copy Homebrew Command": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier la commande Homebrew"
          }
        }
      }
    },
    "Copy Install Command and Open Terminal": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier la commande d’installation et ouvrir Terminal"
          }
        }
      }
    },
    "Discard": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner"
          }
        }
      }
    },
    "Discard Changes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner les modifications"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé"
          }
        }
      }
    },
    "Every change is saved with the value from before, so you can undo it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque modification est enregistrée avec la valeur d’avant, vous pouvez donc l’annuler."
          }
        }
      }
    },
    "Every setting goes back to the value it had before, stopped services start again, and the Apple Intelligence profile is removed. You may be asked for your password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque réglage reprend sa valeur d’avant, les services arrêtés redémarrent et le profil Apple Intelligence est supprimé. Votre mot de passe peut vous être demandé."
          }
        }
      }
    },
    "Every tweak in this file is already applied.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les réglages de ce fichier sont déjà appliqués."
          }
        }
      }
    },
    "Everything UnbloatMyMac changed is back the way it was.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qu’UnbloatMyMac avait modifié est revenu comme avant."
          }
        }
      }
    },
    "Export Tweaks…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter les réglages…"
          }
        }
      }
    },
    "Failed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec"
          }
        }
      }
    },
    "Features marked Profile are turned off by a configuration profile. After you apply, approve it in System Settings > General > Device Management. Removing the profile turns them back on.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctions marquées Profil sont désactivées par un profil de configuration. Après application, approuvez-le dans Réglages Système > Général > Gestion des appareils. Supprimer le profil les réactive."
          }
        }
      }
    },
    "Focus": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentration"
          }
        }
      }
    },
    "Forget the changes you have not applied (Option-Command-Delete)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier les modifications non appliquées (Option-Commande-Supprimer)"
          }
        }
      }
    },
    "Free, open apps and tools that fill gaps in macOS, installed with Homebrew. Nothing installs until you click.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des apps et outils gratuits et ouverts qui comblent les manques de macOS, installés avec Homebrew. Rien ne s’installe sans votre clic."
          }
        }
      }
    },
    "General": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Général"
          }
        }
      }
    },
    "History": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique"
          }
        }
      }
    },
    "Homebrew is not installed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew n’est pas installé"
          }
        }
      }
    },
    "Homebrew is the free package manager most Mac developers use. UnbloatMyMac installs apps with it. Its installer runs in Terminal and asks for your password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew est le gestionnaire de paquets gratuit qu’utilisent la plupart des développeurs Mac. UnbloatMyMac s’en sert pour installer les apps. Son installeur s’exécute dans Terminal et demande votre mot de passe."
          }
        }
      }
    },
    "Import Tweaks…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer les réglages…"
          }
        }
      }
    },
    "Inbox": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réception"
          }
        }
      }
    },
    "Install": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer"
          }
        }
      }
    },
    "Install %lld Recommended": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer %lld recommandées"
          }
        }
      }
    },
    "Install Command Line Tool…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer l’outil en ligne de commande…"
          }
        }
      }
    },
    "Install Recommended Apps": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer les apps recommandées"
          }
        }
      }
    },
    "Installed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installée"
          }
        }
      }
    },
    "Installed without Homebrew. Update and remove it the way you installed it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installée sans Homebrew. Mettez-la à jour et supprimez-la comme vous l’avez installée."
          }
        }
      }
    },
    "Installed. Open a new Terminal window to use it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installé. Ouvrez une nouvelle fenêtre de Terminal pour l’utiliser."
          }
        }
      }
    },
    "Installed. Try “unbloatmymac list” in Terminal.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installé. Essayez « unbloatmymac list » dans Terminal."
          }
        }
      }
    },
    "Installing…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation…"
          }
        }
      }
    },
    "Keep as Is": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser ainsi"
          }
        }
      }
    },
    "Log out and back in to finish every change.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez-vous puis reconnectez-vous pour terminer toutes les modifications."
          }
        }
      }
    },
    "Log out to finish.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez-vous pour terminer."
          }
        }
      }
    },
    "Login Items and App Background Items": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouverture et éléments en arrière-plan des apps"
          }
        }
      }
    },
    "Login items and app background items need your password to read.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture des éléments d’ouverture et en arrière-plan demande votre mot de passe."
          }
        }
      }
    },
    "More for %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus pour %@"
          }
        }
      }
    },
    "No Background Items": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun élément en arrière-plan"
          }
        }
