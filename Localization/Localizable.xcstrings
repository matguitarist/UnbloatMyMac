    },
    "Import Tweaks…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer les réglages…"
          }
        }
      }
    },
    "Inbox": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réception"
          }
        }
      }
    },
    "Install Command Line Tool…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer l’outil en ligne de commande…"
          }
        }
      }
    },
    "Installed. Try “unbloatmymac list” in Terminal.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installé. Essayez « unbloatmymac list » dans Terminal."
          }
        }
      }
    },
    "Keep as Is": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser ainsi"
          }
        }
      }
    },
    "Log out and back in to finish every change.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez-vous puis reconnectez-vous pour terminer toutes les modifications."
          }
        }
      }
    },
    "Log out to finish.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez-vous pour terminer."
          }
        }
      }
    },
    "Login Items and App Background Items": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouverture et éléments en arrière-plan des apps"
          }
        }
      }
    },
    "Login items and app background items need your password to read.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture des éléments d’ouverture et en arrière-plan demande votre mot de passe."
          }
        }
      }
    },
    "No Background Items": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun élément en arrière-plan"
