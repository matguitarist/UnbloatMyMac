{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ can be freed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ à libérer"
          }
        }
      }
    },
    "%@ restart, so the screen may flicker.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ redémarrent, l’écran peut clignoter."
          }
        }
      }
    },
    "%lld advanced tweaks stop system services and are hidden.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld réglages avancés arrêtent des services système et sont masqués."
          }
        }
      }
    },
    "%lld changes applied.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld modifications appliquées."
          }
        }
      }
    },
    "%lld items": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld éléments"
          }
        }
      }
    },
    "%lld of %lld allowed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sur %lld autorisés"
          }
        }
      }
    },
    "%lld of %lld applied": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sur %lld appliqués"
          }
        }
      }
    },
    "%lld tweaks you applied are back to how macOS had them. Apply them again?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld réglages que vous aviez appliqués sont revenus à l’état de macOS. Les appliquer de nouveau ?"
          }
        }
      }
    },
    "1 advanced tweak stops a system service and is hidden.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 réglage avancé arrête un service système et est masqué."
          }
        }
      }
    },
    "1 change applied.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 modification appliquée."
          }
        }
      }
    },
    "1 item": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 élément"
          }
        }
      }
    },
    "1 left": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 restant"
          }
        }
      }
    },
    "Accent color": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleur d’accentuation"
          }
        }
      }
    },
    "Add Full Windows Preset": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter le préréglage Windows complet"
          }
        }
      }
    },
    "Add Preset": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un préréglage"
          }
        }
      }
    },
    "Add Task": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter"
          }
        }
      }
    },
    "Add a set of tweaks to your changes. You review everything before it applies.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un ensemble de réglages à vos modifications. Vous vérifiez tout avant application."
          }
        }
      }
    },
    "Add to Changes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter aux modifications"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancé"
          }
        }
      }
    },
    "After log out": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après déconnexion"
          }
        }
      }
    },
    "All %lld applied": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld sont appliqués"
          }
        }
      }
    },
    "Allow %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser %@"
          }
        }
      }
    },
    "Allow this item to run again": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser de nouveau cet élément"
          }
        }
      }
    },
    "Also adds the Finder, typing, and window tweaks that make the Mac feel like Windows": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute aussi les réglages du Finder, de la saisie et des fenêtres qui donnent au Mac l’allure de Windows"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparence"
          }
        }
      }
    },
    "Apple Intelligence tweaks": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages Apple Intelligence"
          }
        }
      }
    },
    "Applied": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqué"
          }
        }
      }
    },
    "Applied %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ appliqué"
          }
        }
      }
    },
    "Apply Changes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer les modifications"
          }
        }
      }
    },
    "Applying…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Application…"
          }
        }
      }
    },
    "Approve in System Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À approuver dans Réglages Système"
          }
        }
      }
    },
    "Approve “UnbloatMyMac: Apple Intelligence” in System Settings > General > Device Management.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuvez « UnbloatMyMac: Apple Intelligence » dans Réglages Système > Général > Gestion des appareils."
          }
        }
      }
    },
    "Background Items": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éléments en arrière-plan"
          }
        }
      }
    },
    "Caches, leftovers, and developer files that can safely go. Files move to the Trash; empty it to free the space.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, restes et fichiers de développement dont vous pouvez vous passer. Les fichiers vont dans la corbeille ; videz-la pour libérer l’espace."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        }
      }
    },
    "Categories": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Catégories"
          }
        }
      }
    },
    "Change this item in System Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier cet élément dans Réglages Système"
          }
        }
      }
    },
    "Changes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifications"
          }
        }
      }
    },
    "Changes show at once. Turn off to see them after you log out.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications sont visibles tout de suite. Désactivez pour les voir après déconnexion."
          }
        }
      }
    },
    "Changes you apply show here, and you can undo all of them at once.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications appliquées s’affichent ici, et vous pouvez toutes les annuler d’un coup."
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher des mises à jour…"
          }
        }
      }
    },
    "Choose a tweaks file saved by UnbloatMyMac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier de réglages enregistré par UnbloatMyMac."
          }
        }
      }
    },
    "Clean": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyer"
          }
        }
      }
    },
    "Clean %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyer %@"
          }
        }
      }
    },
    "Clean %@?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyer %@ ?"
          }
        }
      }
    },
    "Clean…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyer…"
          }
        }
      }
    },
    "Discard": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner"
          }
        }
      }
    },
    "Discard Changes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandonner les modifications"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé"
          }
        }
      }
    },
    "Every change is saved with the value from before, so you can undo it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque modification est enregistrée avec la valeur d’avant, vous pouvez donc l’annuler."
          }
        }
      }
    },
    "Every setting goes back to the value it had before, stopped services start again, and the Apple Intelligence profile is removed. You may be asked for your password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque réglage reprend sa valeur d’avant, les services arrêtés redémarrent et le profil Apple Intelligence est supprimé. Votre mot de passe peut vous être demandé."
          }
        }
      }
    },
    "Every tweak in this file is already applied.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les réglages de ce fichier sont déjà appliqués."
          }
        }
      }
    },
    "Everything UnbloatMyMac changed is back the way it was.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qu’UnbloatMyMac avait modifié est revenu comme avant."
          }
        }
      }
    },
    "Export Tweaks…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter les réglages…"
          }
        }
      }
    },
    "Failed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec"
          }
        }
      }
    },
    "Features marked Profile are turned off by a configuration profile. After you apply, approve it in System Settings > General > Device Management. Removing the profile turns them back on.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctions marquées Profil sont désactivées par un profil de configuration. Après application, approuvez-le dans Réglages Système > Général > Gestion des appareils. Supprimer le profil les réactive."
          }
        }
      }
    },
    "Focus": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentration"
          }
        }
      }
    },
    "Forget the changes you have not applied (Option-Command-Delete)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublier les modifications non appliquées (Option-Commande-Supprimer)"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Général"
          }
