      }
    },
    "Files": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers"
          }
        }
      }
    },
    "Apps": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps"
          }
        }
      }
    },
    "Clear the activity log?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer le journal d’activité ?"
          }
        }
      }
    },
    "Every line is deleted. Your changes and their undo history are kept.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les lignes sont supprimées. Vos modifications et leur historique d’annulation sont conservés."
          }
        }
      }
    },
    "Save the activity log as text, to attach to a bug report.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez le journal d’activité en texte, à joindre à un rapport de bug."
          }
        }
      }
    },
    "Export Activity Log…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter le journal d’activité…"
          }
        }
      }
    },
    "Clear Activity Log…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer le journal d’activité…"
          }
        }
      }
    },
    "Show Log Inspector": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher l’inspecteur du journal"
          }
        }
      }
    },
    "Hide Log Inspector": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer l’inspecteur du journal"
          }
        }
      }
    },
    "UnbloatMyMac Help": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide UnbloatMyMac"
          }
        }
      }
    },
    "Show Activity Log": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le journal d’activité"
          }
        }
      }
    },
    "What's New": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveautés"
          }
        }
      }
    },
    "UnbloatMyMac on GitHub": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UnbloatMyMac sur GitHub"
          }
        }
      }
    },
    "Report a Problem or Suggest an Idea…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaler un problème ou proposer une idée…"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
