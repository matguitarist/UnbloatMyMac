            "state": "translated",
            "value": "Apple Intelligence"
          }
        }
      }
    },
    "Apple Intelligence features are turned off with a configuration profile, the same way a company manages its Macs. UnbloatMyMac puts every Apple Intelligence restriction in one profile.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
