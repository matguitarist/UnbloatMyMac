        }
      }
    },
    "Select a line to see the exact command, value, or file it wrote.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une ligne pour voir la commande, la valeur ou le fichier exact qu’elle a écrit."
          }
        }
      }
    },
    "The log keeps the latest 5,000 lines. Lines are in English, so you can paste them in a bug report.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal garde les 5 000 dernières lignes. Elles sont en anglais, pour pouvoir les coller dans un rapport de bug."
          }
        }
      }
    },
    "Debug": {
