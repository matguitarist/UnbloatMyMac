        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touches"
          }
        }
      }
    },
    "Keys repeat sooner and faster than System Settings allows.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches se répètent plus tôt et plus vite que ce que permet Réglages Système."
          }
        }
      }
    },
    "Language, image, and photo models in /System/Library/AssetsV2. System Integrity Protection keeps any app from deleting them; turning off Apple Intelligence in System Settings makes macOS remove them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèles de langage, d’image et de photo dans /System/Library/AssetsV2. La protection de l’intégrité du système empêche toute app de les supprimer ; désactiver Apple Intelligence dans Réglages Système les fait supprimer par macOS."
          }
        }
      }
    },
    "Leftovers from Deleted Apps": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restes d’apps supprimées"
          }
        }
      }
    },
    "Lets anyone use this Mac without a password, in a guest account.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à n’importe qui d’utiliser ce Mac sans mot de passe, dans un compte invité."
          }
        }
      }
    },
    "Lets apps on other Macs control apps on this one with AppleScript.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet aux apps d’autres Mac de piloter les apps de celui-ci avec AppleScript."
          }
        }
      }
    },
    "Lets other computers sign in to this Mac with SSH.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à d’autres ordinateurs de se connecter à ce Mac par SSH."
          }
        }
      }
    },
    "Lets other devices wake this Mac over the network to reach shared files and media.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet à d’autres appareils de réveiller ce Mac par le réseau pour accéder aux fichiers et médias partagés."
          }
        }
      }
    },
