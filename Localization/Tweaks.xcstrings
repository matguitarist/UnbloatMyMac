        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancrer les fenêtres aux bords"
          }
        }
      }
    },
    "Snap windows to halves, thirds, and corners with keyboard shortcuts, like Windows-Arrow.": {
      "localizations": {
