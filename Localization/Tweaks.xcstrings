      }
    },
    "Finder shows hidden files and full paths, quotes and dashes stay as you type them, and Terminal tools are offered.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Finder montre les fichiers cachés et les chemins complets, les guillemets et tirets restent tels que tapés, et des outils pour le Terminal sont proposés."
          }
        }
      }
    },
