        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touches Début et Fin"
          }
        }
      }
    },
    "Home and End go to the start and end of the line; Control goes to the document.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Début et Fin vont au début et à la fin de la ligne ; avec Contrôle, au début et à la fin du document."
          }
        }
      }
    },
    "Homebrew could not finish.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew n’a pas pu terminer."
          }
        }
