    "Time Machine Local Snapshots": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantanés locaux Time Machine"
          }
        }
      }
    },
    "Tips Notifications": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications Astuces"
          }
        }
      }
    },
    "Transcribes recordings, meetings, and videos on your Mac. Free, with paid extras.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrit enregistrements, réunions et vidéos sur votre Mac. Gratuit, avec des options payantes."
          }
        }
      }
    },
    "Turn off Writing Tools, Genmoji, Image Playground, ChatGPT, summaries, Siri, and the background services behind them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez Outils d’écriture, Genmoji, Image Playground, ChatGPT, les résumés, Siri et les services qui les font tourner."
          }
        }
      }
    },
    "Turn on the firewall, close doors other computers could use to get in, and check FileVault, Gatekeeper, and security updates.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le pare-feu, fermez les portes que d’autres ordinateurs pourraient utiliser pour entrer, et vérifiez FileVault, Gatekeeper et les mises à jour de sécurité."
          }
        }
      }
    },
    "Turns sketches in Notes into generated images.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme les croquis de Notes en images générées."
          }
        }
      }
    },
    "Two hyphens turn into a dash.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux traits d’union deviennent un tiret."
          }
        }
      }
    },
    "Two spaces turn into a period and a space.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux espaces deviennent un point et une espace."
          }
        }
      }
    },
    "Typing": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisie"
          }
        }
      }
    },
    "Unavailable Simulators": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulateurs indisponibles"
          }
        }
      }
    },
    "Updates everything with one command: Homebrew, App Store apps, npm, pip, Rust, and more.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met tout à jour en une commande : Homebrew, les apps de l’App Store, npm, pip, Rust et plus."
          }
        }
      }
    },
    "Uses more battery.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise davantage la batterie."
          }
        }
      }
    },
    "Visual Intelligence": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligence visuelle"
          }
        }
      }
    },
    "Wake for Network Access": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réactiver pour l’accès au réseau"
          }
        }
      }
    },
    "Web App Caches": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches des apps web"
          }
        }
      }
    },
    "What apps saved to reopen their windows where you left them. Apps open with fresh windows next time.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que les apps ont enregistré pour rouvrir leurs fenêtres là où vous les aviez laissées. Elles s’ouvriront avec de nouvelles fenêtres la prochaine fois."
          }
        }
      }
    },
    "Widgets on the desktop and in Stage Manager.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les widgets sur le bureau et dans Stage Manager."
          }
        }
      }
    },
    "Window Animations": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animations des fenêtres"
          }
        }
      }
    },
    "Window screenshots have a large shadow around them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures de fenêtres ont une grande ombre autour."
          }
        }
      }
    },
    "Windows": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenêtres"
          }
        }
      }
    },
    "Windows Habits": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Habitudes Windows"
          }
        }
      }
    },
    "Windows Mode": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode Windows"
          }
        }
      }
    },
    "Windows Mode: scrolling, function keys, Home and End, maximize, and drives on the desktop.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode Windows : défilement, touches de fonction, Début et Fin, agrandir et disques sur le bureau."
          }
        }
      }
    },
    "Windows Scroll Direction": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défilement façon Windows"
          }
        }
      }
    },
    "Windows and sheets zoom in when they open.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres et les feuilles s’agrandissent en s’ouvrant."
          }
        }
      }
    },
    "Windows resize in one step when you zoom them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres se redimensionnent en une étape quand vous les agrandissez."
          }
        }
      }
    },
    "Windows shrink instead of the slower Genie effect.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres rétrécissent au lieu de l’effet Génie, plus lent."
          }
        }
      }
    },
    "Windows zoom, the Dock bounces, and Mission Control slides. Without them, everything shows at once.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres zooment, le Dock rebondit et Mission Control glisse. Sans elles, tout s’affiche aussitôt."
          }
        }
      }
    },
    "Windows, the Dock, and Finder skip their animations, and photo analysis stops running in the background.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fenêtres, le Dock et le Finder sautent leurs animations, et l’analyse des photos s’arrête en arrière-plan."
          }
        }
      }
    },
    "Works in Mac text fields, not in Terminal or every app. Control-A no longer jumps to the start of the line.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne dans les champs de texte du Mac, pas dans Terminal ni dans toutes les apps. Contrôle-A ne va plus au début de la ligne."
          }
        }
      }
    },
    "Works while the firewall is on.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne tant que le pare-feu est activé."
          }
        }
      }
    },
    "Writes ~/Library/KeyBindings/DefaultKeyBinding.dict. Your own file comes back when you turn off every key tweak.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit ~/Library/KeyBindings/DefaultKeyBinding.dict. Votre propre fichier revient quand vous désactivez tous les réglages de touches."
          }
        }
      }
    },
    "Writing Tools": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Outils d’écriture"
          }
        }
      }
    },
    "Writing Tools, Genmoji, Image Playground, ChatGPT, and summaries in Mail, Notes, and Safari.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Outils d’écriture, Genmoji, Image Playground, ChatGPT et les résumés dans Mail, Notes et Safari."
          }
        }
      }
    },
    "Xcode Derived Data": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données dérivées Xcode"
          }
        }
      }
    },
    "Xcode Device Support": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prise en charge des appareils Xcode"
          }
        }
      }
    },
    "You canceled the password prompt, so nothing that needs it changed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez annulé la demande de mot de passe, rien de ce qui en dépend n’a changé."
          }
        }
      }
    },
    "Your Agents": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos agents"
          }
        }
      }
    },
    "Your Mac asks for your password when it starts.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac demande votre mot de passe au démarrage."
          }
        }
      }
    },
    "Your Mac does not answer pings and port scans, so it is harder to find on a network.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac ne répond pas aux pings ni aux scans de ports, il est donc plus difficile à repérer sur un réseau."
          }
        }
      }
    },
    "Your Mac keeps working like a Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac continue de fonctionner comme un Mac."
          }
        }
      }
    },
    "Your Mac signs in without a password when it starts. Turn off Automatic Login in Users & Groups.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre Mac ouvre la session sans mot de passe au démarrage. Désactivez la connexion automatique dans Utilisateurs et groupes."
          }
        }
      }
    },
    "Your disk is encrypted, so a lost or stolen Mac does not give away your files.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre disque est chiffré : un Mac perdu ou volé ne livre pas vos fichiers."
          }
        }
      }
    },
    "Your disk is not encrypted. Anyone who takes your Mac can read your files. Turn on FileVault in Privacy & Security.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre disque n’est pas chiffré. Quiconque prend votre Mac peut lire vos fichiers. Activez FileVault dans Confidentialité et sécurité."
          }
        }
      }
    },
    "Your pinned apps are kept and come back when you turn this off.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos apps épinglées sont conservées et reviennent quand vous désactivez ceci."
          }
        }
      }
    },
    "iPhone and iPad Updates": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour d’iPhone et d’iPad"
          }
        }
      }
    },
    "macOS Installers": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeurs de macOS"
          }
        }
      }
    },
    "macOS did not accept %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas accepté %@."
          }
        }
      }
    },
    "macOS keeps a record of every file you downloaded, with the website it came from. Cleared at once; the files you downloaded stay.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS garde une trace de chaque fichier téléchargé, avec le site d’où il vient. Effacé immédiatement ; les fichiers téléchargés restent."
          }
        }
      }
    },
    "macOS protects this setting. Give UnbloatMyMac Full Disk Access in System Settings > Privacy & Security, then try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS protège ce réglage. Donnez à UnbloatMyMac l’accès complet au disque dans Réglages Système > Confidentialité et sécurité, puis réessayez."
          }
        }
      }
    },
    "macOS system files are protected, even from apps with your password.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers système de macOS sont protégés, même des apps qui ont votre mot de passe."
          }
        }
      }
    },
    "macOS would not start %@ again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n’a pas voulu redémarrer %@."
          }
        }
