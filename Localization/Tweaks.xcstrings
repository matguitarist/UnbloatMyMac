{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ did not quit, so its caches stayed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas quitté, ses caches sont donc restés."
          }
        }
      }
    },
    "%lld of %lld items are in use or protected and stayed where they were.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld éléments sur %lld sont utilisés ou protégés et sont restés en place."
          }
        }
      }
    },
    "A cat with syntax colors and line numbers.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cat avec coloration syntaxique et numéros de ligne."
          }
        }
      }
    },
    "A cd that remembers: type z and part of a folder name to jump there.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cd qui se souvient : tapez z et une partie du nom d’un dossier pour y aller."
          }
        }
      }
    },
    "A clearer ls with colors, Git status, and folders first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ls plus clair, avec couleurs, état Git et dossiers en premier."
          }
        }
      }
    },
    "A fast model server built on Apple's MLX, with an OpenAI-compatible API for other apps.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un serveur de modèles rapide basé sur MLX d’Apple, avec une API compatible OpenAI pour les autres apps."
          }
        }
      }
    },
    "A fast, native terminal app.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app de terminal rapide et native."
          }
        }
      }
    },
    "A floating thumbnail shows after each screenshot, before it saves.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vignette flottante s’affiche après chaque capture, avant l’enregistrement."
          }
        }
      }
    },
    "A free firewall that asks before an app connects to the internet for the first time.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pare-feu gratuit qui demande avant qu’une app se connecte à Internet pour la première fois."
          }
        }
      }
    },
    "A hidden Dock shows the moment the pointer reaches it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Dock masqué apparaît dès que le pointeur l’atteint."
          }
        }
      }
    },
    "A light tap on the trackpad clicks, like most Windows laptops.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un léger toucher sur le trackpad clique, comme sur la plupart des PC portables Windows."
          }
        }
      }
    },
    "A nicer prompt and faster replacements for classic commands.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une invite plus agréable et des remplaçants plus rapides des commandes classiques."
          }
        }
      }
    },
    "A prompt that shows the folder, Git branch, and how long a command took. Needs a Nerd Font.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une invite qui montre le dossier, la branche Git et la durée d’une commande. Demande une police Nerd Font."
          }
        }
      }
    },
    "A quieter, faster Dock and window manager.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Dock et un gestionnaire de fenêtres plus calmes et plus rapides."
          }
        }
      }
    },
    "A section of recently used apps in the Dock.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une section des apps récemment utilisées dans le Dock."
          }
        }
      }
    },
    "A separate scroll direction for the mouse and the trackpad, and no mouse acceleration.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sens de défilement distinct pour la souris et le trackpad, et pas d’accélération de la souris."
          }
        }
      }
    },
    "A service reads your mail and messages to suggest contacts and events.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un service lit vos e-mails et messages pour suggérer des contacts et des événements."
          }
        }
      }
    },
    "A simple, fast find.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un find simple et rapide."
          }
        }
      }
    },
    "A small menu bar model server built on MLX, with chat and an OpenAI-compatible API.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit serveur de modèles dans la barre des menus, basé sur MLX, avec une discussion et une API compatible OpenAI."
          }
        }
      }
    },
    "A small open-source window that shows which App Store and Sparkle apps have updates.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une petite fenêtre open source qui montre quelles apps de l’App Store et Sparkle ont des mises à jour."
          }
        }
      }
    },
    "AI that runs on your Mac, offline, with nothing sent to a server. Each model is a download of several gigabytes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une IA qui tourne sur votre Mac, hors ligne, sans rien envoyer à un serveur. Chaque modèle est un téléchargement de plusieurs gigaoctets."
          }
        }
      }
    },
    "Accent Menu on Held Keys": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu des accents sur touche maintenue"
          }
        }
      }
    },
    "Accessibility Effects": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effets d’accessibilité"
          }
        }
      }
    },
    "Ad Services": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Services publicitaires"
          }
        }
      }
    },
    "Advertising": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicité"
          }
        }
      }
    },
    "Agents for All Users": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents pour tous les utilisateurs"
          }
        }
      }
    },
    "Agents that collect input, location, and app analytics.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents qui collectent des données de saisie, de position et d’usage des apps."
          }
        }
      }
    },
    "AirDrop for Contacts Only": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop pour les contacts seulement"
          }
        }
      }
    },
    "All in One": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout-en-un"
          }
        }
      }
    },
    "Always Show Scroll Bars": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours afficher les barres de défilement"
          }
        }
      }
    },
    "An open-source uninstaller that also finds files left behind by apps you already deleted.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un désinstalleur open source qui trouve aussi les fichiers laissés par les apps déjà supprimées."
          }
        }
      }
    },
    "An open-source uninstaller that shows why each leftover file belongs to its app, finds what builds left in your projects, and can put back what it moved.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un désinstalleur open source qui montre pourquoi chaque fichier restant appartient à son app, trouve ce que les compilations ont laissé dans vos projets, et peut remettre ce qu’il a déplacé."
          }
        }
      }
    },
    "An open-source, offline alternative to ChatGPT.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une alternative à ChatGPT, open source et hors ligne."
          }
        }
      }
    },
    "Analytics": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse"
          }
        }
      }
    },
    "Analytics Agents": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents d’analyse"
          }
        }
      }
    },
    "Analytics, ad services, browser telemetry, and Game Center off, the firewall on, and LuLu to see what apps send.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyses, services publicitaires, télémétrie des navigateurs et Game Center désactivés, coupe-feu activé, et LuLu pour voir ce que les apps envoient."
          }
        }
      }
    },
    "Animations": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animations"
          }
        }
      }
    },
    "Animations stay as they are.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les animations restent telles quelles."
          }
        }
      }
    },
    "Annoyances": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désagréments"
          }
        }
      }
    },
    "Any app opens without a malware check. Turn it back on in Terminal with: sudo spctl --global-enable": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’importe quelle app s’ouvre sans contrôle antimalware. Réactivez-le dans Terminal avec : sudo spctl --global-enable"
          }
        }
      }
    },
    "App Caches": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches des apps"
          }
        }
      }
    },
    "App Launch Animation": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation d’ouverture des apps"
          }
        }
      }
    },
    "App Nap": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Nap"
          }
        }
      }
    },
    "App Updates": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour des apps"
          }
        }
      }
    },
    "Apple Intelligence": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        }
      }
    },
    "Apple Intelligence Models": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèles Apple Intelligence"
          }
        }
      }
    },
    "Apple Intelligence off, no personalized ads, fewer pop-ups. Nothing you would miss.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence désactivée, pas de publicités personnalisées, moins de fenêtres surgissantes. Rien qui vous manquera."
          }
        }
      }
    },
    "Apple Intelligence stays as it is.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence reste tel quel."
          }
        }
      }
    },
    "Apple's tools to run and fine-tune models with MLX from the command line.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils d’Apple pour lancer et affiner des modèles avec MLX en ligne de commande."
          }
        }
      }
    },
    "Applies the next time Chrome opens. Chrome may say it is managed by your organization.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à la prochaine ouverture de Chrome. Chrome peut indiquer qu’il est géré par votre organisation."
          }
        }
      }
    },
    "Applies the next time Edge opens. Edge may say it is managed by your organization.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à la prochaine ouverture d’Edge. Edge peut indiquer qu’il est géré par votre organisation."
          }
        }
      }
    },
    "Applies the next time Firefox opens. Firefox says it is managed by your organization.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à la prochaine ouverture de Firefox. Firefox indique qu’il est géré par votre organisation."
          }
        }
      }
    },
    "Apps and System": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps et système"
          }
        }
      }
    },
    "Apps are checked for malware and a known developer before they open.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps sont vérifiées (malwares, développeur identifié) avant de s’ouvrir."
          }
        }
      }
    },
    "Apps bounce in the Dock to get your attention.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps rebondissent dans le Dock pour attirer votre attention."
          }
        }
      }
    },
    "Apps that bring back what you miss from Windows.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des apps qui ramènent ce qui vous manque de Windows."
          }
        }
      }
    },
    "Apps that quit unexpectedly show a report window.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps qui quittent inopinément affichent une fenêtre de rapport."
          }
        }
      }
    },
    "Are you used to Windows?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous habitué à Windows ?"
          }
        }
      }
    },
    "Autocorrect": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Correction automatique"
          }
        }
      }
    },
    "Automatic Capitals": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Majuscules automatiques"
          }
        }
      }
    },
    "Automatic Login": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion automatique"
          }
        }
      }
    },
    "Background Services": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Services d’arrière-plan"
          }
        }
      }
    },
    "Background Work": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tâches de fond"
          }
        }
      }
    },
    "Balanced": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équilibrée"
          }
        }
      }
    },
    "Behavior": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comportement"
          }
        }
      }
    },
    "Blocks incoming connections to apps you have not allowed. macOS asks the first time an app wants them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque les connexions entrantes vers les apps que vous n’avez pas autorisées. macOS demande la première fois qu’une app en veut."
          }
        }
      }
    },
    "Bouncing Icons": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Icônes qui rebondissent"
          }
        }
      }
    },
    "Brightness and volume keys for external displays.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touches de luminosité et de volume pour les écrans externes."
          }
        }
      }
    },
    "Build products and indexes. Xcode rebuilds them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Produits de compilation et index. Xcode les recrée."
          }
        }
      }
    },
    "Builds image, video, and audio pipelines from nodes. The most flexible image generator.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construit des chaînes d’image, de vidéo et d’audio à partir de nœuds. Le générateur d’images le plus souple."
          }
        }
      }
    },
    "CPU, memory, disk, network, and battery in the menu bar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Processeur, mémoire, disque, réseau et batterie dans la barre des menus."
          }
        }
      }
    },
    "CPU, memory, disks, and processes in the terminal, like Task Manager.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Processeur, mémoire, disques et processus dans le terminal, comme le Gestionnaire des tâches."
          }
        }
      }
    },
    "Caches that Slack, Discord, VS Code, and other apps built on Chrome keep in Application Support. They rebuild them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches que Slack, Discord, VS Code et d’autres apps basées sur Chrome gardent dans Application Support. Elles les recréent."
          }
        }
      }
    },
    "Caches the iOS Simulator rebuilds when it starts.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches que le Simulateur iOS recrée à son lancement."
          }
        }
      }
    },
    "Call Intelligence": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligence des appels"
          }
        }
      }
    },
    "Call and audio transcripts with summaries in Notes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriptions d’appels et d’audio avec résumés dans Notes."
          }
        }
      }
    },
    "Call screening, live translation, and call summaries.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le filtrage des appels, la traduction en direct et les résumés d’appels."
          }
        }
      }
    },
    "Capitalizes the first word of each sentence.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met une majuscule au premier mot de chaque phrase."
          }
        }
      }
    },
    "Chat with your own documents and notes using a local model.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discutez avec vos propres documents et notes grâce à un modèle local."
          }
        }
      }
    },
    "ChatGPT and Other Models": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT et autres modèles"
          }
        }
      }
    },
    "Chrome Usage Reports": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapports d’utilisation de Chrome"
          }
        }
      }
    },
    "Chrome sends usage statistics, crash reports, and the pages you visit to Google.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome envoie à Google des statistiques d’utilisation, des rapports de plantage et les pages que vous visitez."
          }
        }
      }
    },
    "Cleaned %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nettoyé"
          }
        }
      }
    },
    "Cleaned %lld Xcode device support versions": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld versions de prise en charge d’appareils Xcode nettoyées"
          }
        }
      }
    },
    "Cleaned leftovers of %lld deleted apps": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restes de %lld apps supprimées nettoyés"
          }
        }
      }
    },
    "Cleaners": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyage"
          }
        }
      }
    },
    "Cleans caches, logs, and leftovers, removes apps completely, and shows what fills your disk, all from one command: mo.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoie les caches, les journaux et les restes, supprime complètement les apps et montre ce qui remplit votre disque, le tout avec une seule commande : mo."
          }
        }
      }
    },
    "Click Wallpaper to Show Desktop": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer sur le fond d’écran pour afficher le bureau"
          }
        }
      }
    },
    "Clicking the wallpaper hides every window to show the desktop.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer sur le fond d’écran masque toutes les fenêtres pour afficher le bureau."
          }
        }
      }
    },
    "Clipboard history in the menu bar, like Windows-V.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique du presse-papiers dans la barre des menus, comme Windows-V."
          }
        }
      }
    },
    "Command Line": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligne de commande"
          }
        }
      }
    },
