            "state": "translated",
            "value": "Le Dock reste en bas, toujours visible, sans agrandissement."
          }
        }
      }
    },
    "The Game Center service and its sign-in pop-ups.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service Game Center et ses fenêtres de connexion."
          }
        }
      }
    },
    "The Image Playground app and image generation in other apps.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app Image Playground et la génération d’images dans les autres apps."
          }
        }
      }
    },
    "The Mac wakes while asleep to check mail and back up.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac se réveille pendant la veille pour relever le courrier et sauvegarder."
          }
