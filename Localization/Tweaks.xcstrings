{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%lld of %lld items are in use or protected and stayed where they were.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld éléments sur %lld sont utilisés ou protégés et sont restés en place."
          }
        }
      }
    },
    "A cat with syntax colors and line numbers.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cat avec coloration syntaxique et numéros de ligne."
          }
        }
      }
    },
    "A cd that remembers: type z and part of a folder name to jump there.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cd qui se souvient : tapez z et une partie du nom d’un dossier pour y aller."
          }
        }
      }
    },
    "A clearer ls with colors, Git status, and folders first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ls plus clair, avec couleurs, état Git et dossiers en premier."
          }
        }
      }
    },
    "A fast model server built on Apple's MLX, with an OpenAI-compatible API for other apps.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un serveur de modèles rapide basé sur MLX d’Apple, avec une API compatible OpenAI pour les autres apps."
          }
        }
      }
    },
    "A fast, native terminal app.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app de terminal rapide et native."
          }
        }
      }
    },
    "A free firewall that asks before an app connects to the internet for the first time.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pare-feu gratuit qui demande avant qu’une app se connecte à Internet pour la première fois."
          }
        }
      }
    },
    "A hidden Dock shows the moment the pointer reaches it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Dock masqué apparaît dès que le pointeur l’atteint."
          }
        }
      }
    },
    "A light tap on the trackpad clicks, like most Windows laptops.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un léger toucher sur le trackpad clique, comme sur la plupart des PC portables Windows."
          }
        }
      }
    },
    "A nicer prompt and faster replacements for classic commands.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une invite plus agréable et des remplaçants plus rapides des commandes classiques."
          }
        }
      }
    },
    "A prompt that shows the folder, Git branch, and how long a command took. Needs a Nerd Font.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une invite qui montre le dossier, la branche Git et la durée d’une commande. Demande une police Nerd Font."
          }
        }
      }
    },
    "A quieter, faster Dock and window manager.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Dock et un gestionnaire de fenêtres plus calmes et plus rapides."
          }
        }
      }
    },
    "A separate scroll direction for the mouse and the trackpad, and no mouse acceleration.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sens de défilement distinct pour la souris et le trackpad, et pas d’accélération de la souris."
          }
        }
      }
    },
    "A simple, fast find.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un find simple et rapide."
          }
        }
      }
    },
    "A small menu bar model server built on MLX, with chat and an OpenAI-compatible API.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit serveur de modèles dans la barre des menus, basé sur MLX, avec une discussion et une API compatible OpenAI."
          }
        }
      }
    },
    "A small open-source window that shows which App Store and Sparkle apps have updates.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une petite fenêtre open source qui montre quelles apps de l’App Store et Sparkle ont des mises à jour."
          }
        }
      }
    },
    "AI that runs on your Mac, offline, with nothing sent to a server. Each model is a download of several gigabytes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une IA qui tourne sur votre Mac, hors ligne, sans rien envoyer à un serveur. Chaque modèle est un téléchargement de plusieurs gigaoctets."
          }
        }
      }
    },
    "Accent Menu on Held Keys": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu des accents sur touche maintenue"
          }
        }
      }
    },
    "Accessibility Effects": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effets d’accessibilité"
          }
        }
      }
    },
    "Ad Services": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Services publicitaires"
          }
        }
      }
    },
    "Advertising": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Publicité"
          }
        }
      }
    },
    "Agents for All Users": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents pour tous les utilisateurs"
          }
        }
      }
    },
    "All in One": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout-en-un"
          }
        }
      }
    },
    "Always Show Scroll Bars": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours afficher les barres de défilement"
          }
        }
      }
    },
    "An open-source, offline alternative to ChatGPT.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une alternative à ChatGPT, open source et hors ligne."
          }
        }
      }
    },
    "Analytics": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse"
          }
        }
      }
    },
    "Analytics Agents": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents d’analyse"
          }
        }
      }
    },
    "Animations": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animations"
          }
        }
      }
    },
    "Annoyances": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désagréments"
          }
        }
      }
    },
    "App Caches": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches des apps"
          }
        }
      }
    },
    "App Launch Animation": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation d’ouverture des apps"
          }
        }
      }
    },
    "App Nap": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Nap"
          }
        }
      }
    },
    "App Updates": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour des apps"
          }
        }
      }
    },
    "Apple Intelligence": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence"
          }
        }
      }
    },
    "Apple Intelligence Models": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèles Apple Intelligence"
          }
        }
      }
    },
    "Apple Intelligence off, no personalized ads, fewer pop-ups. Nothing you would miss.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence désactivée, pas de publicités personnalisées, moins de fenêtres surgissantes. Rien qui vous manquera."
          }
        }
      }
    },
    "Apple's tools to run and fine-tune models with MLX from the command line.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils d’Apple pour lancer et affiner des modèles avec MLX en ligne de commande."
          }
        }
      }
    },
    "Apps in the background keep full speed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps en arrière-plan gardent toute leur vitesse."
          }
        }
      }
    },
    "Apps no longer bounce in the Dock to get your attention.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps ne rebondissent plus dans le Dock pour attirer votre attention."
          }
        }
      }
    },
    "Apps that bring back what you miss from Windows.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des apps qui ramènent ce qui vous manque de Windows."
          }
        }
      }
    },
    "Apps that quit unexpectedly no longer show a report window.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps qui quittent inopinément n’affichent plus de rapport."
          }
        }
      }
    },
    "Autocorrect": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Correction automatique"
          }
        }
      }
    },
    "Automatic Capitals": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Majuscules automatiques"
          }
        }
      }
    },
    "Background Services": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Services d’arrière-plan"
          }
        }
      }
    },
    "Background Work": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tâches de fond"
          }
        }
      }
    },
    "Behavior": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comportement"
          }
        }
      }
    },
    "Bouncing Icons": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Icônes qui rebondissent"
          }
        }
      }
    },
    "Brightness and volume keys for external displays.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touches de luminosité et de volume pour les écrans externes."
          }
        }
      }
    },
    "Build products and indexes. Xcode rebuilds them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Produits de compilation et index. Xcode les recrée."
          }
        }
      }
    },
    "Builds image, video, and audio pipelines from nodes. The most flexible image generator.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construit des chaînes d’image, de vidéo et d’audio à partir de nœuds. Le générateur d’images le plus souple."
          }
        }
      }
    },
    "CPU, memory, disk, network, and battery in the menu bar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Processeur, mémoire, disque, réseau et batterie dans la barre des menus."
          }
        }
      }
    },
    "CPU, memory, disks, and processes in the terminal, like Task Manager.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Processeur, mémoire, disques et processus dans le terminal, comme le Gestionnaire des tâches."
          }
        }
      }
    },
    "Call Intelligence": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligence des appels"
          }
        }
      }
    },
    "Call and audio transcripts with summaries in Notes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriptions d’appels et d’audio avec résumés dans Notes."
          }
        }
      }
    },
    "Chat with your own documents and notes using a local model.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discutez avec vos propres documents et notes grâce à un modèle local."
          }
        }
      }
    },
    "ChatGPT and Other Models": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT et autres modèles"
          }
        }
      }
    },
    "Cleaned %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nettoyé"
          }
        }
      }
    },
    "Click Wallpaper to Show Desktop": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer sur le fond d’écran pour afficher le bureau"
          }
        }
      }
    },
    "Clicking the wallpaper no longer hides every window.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquer sur le fond d’écran ne masque plus toutes les fenêtres."
          }
        }
      }
    },
    "Clipboard history in the menu bar, like Windows-V.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique du presse-papiers dans la barre des menus, comme Windows-V."
          }
        }
      }
    },
    "Command Line": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligne de commande"
          }
        }
      }
    },
    "Control Shortcuts in Text": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourcis Contrôle dans le texte"
          }
        }
      }
    },
    "Control-C, V, X, Z, Y, and A copy, paste, cut, undo, redo, and select all in text fields.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôle-C, V, X, Z, Y et A copient, collent, coupent, annulent, rétablissent et sélectionnent tout dans les champs de texte."
          }
        }
      }
    },
    "Corrections": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrections"
          }
        }
      }
    },
    "Could not change ~/.zshrc.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de modifier ~/.zshrc."
          }
        }
      }
    },
    "Could not restore %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de restaurer %@."
          }
        }
      }
    },
    "Could not write %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’écrire %@."
          }
        }
      }
    },
    "Crash Report Pop-ups": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenêtres de rapport de plantage"
          }
        }
      }
    },
    "Debug symbols for every iPhone, iPad, and Watch version you connected.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Symboles de débogage pour chaque version d’iPhone, d’iPad et de Watch connectée."
          }
        }
      }
    },
    "Desktop": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bureau"
          }
        }
      }
    },
    "Desktop Widgets": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets du bureau"
          }
        }
      }
    },
    "Diagnostic logs written by apps.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journaux de diagnostic écrits par les apps."
          }
        }
      }
    },
    "Dim Hidden Apps": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estomper les apps masquées"
          }
        }
      }
    },
    "Disks, USB drives, and servers show on the desktop, like This PC.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disques, clés USB et serveurs apparaissent sur le bureau, comme Ce PC."
          }
        }
      }
    },
    "Dock": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock"
          }
        }
      }
    },
    "Dock & Windows": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock et fenêtres"
          }
        }
      }
    },
    "Dock as a Taskbar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock façon barre des tâches"
          }
        }
      }
    },
    "Don’t Reopen Windows": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas rouvrir les fenêtres"
          }
        }
      }
    },
    "Double-Click Title Bar to Maximize": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-clic sur la barre de titre pour agrandir"
          }
        }
      }
    },
    "Double-Space Period": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Point avec double espace"
          }
        }
      }
    },
    "Double-clicking a title bar fills the screen.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un double-clic sur une barre de titre remplit l’écran."
          }
        }
      }
    },
    "Drag a window to a screen edge or the top to tile or maximize it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une fenêtre vers un bord ou le haut de l’écran pour la mettre en mosaïque ou l’agrandir."
          }
        }
      }
    },
    "Drives on the Desktop": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disques sur le bureau"
          }
        }
      }
    },
    "Empty Trash After 30 Days": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vider la corbeille après 30 jours"
          }
        }
      }
    },
    "Every Apple Intelligence feature stops until you turn this off.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les fonctions Apple Intelligence s’arrêtent tant que ceci est actif."
          }
        }
      }
    },
    "Every file name ends in its extension, like report.pdf.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque nom de fichier se termine par son extension, comme rapport.pdf."
          }
        }
      }
    },
    "Everything in Recommended, plus Siri, analytics, ad services, and Game Center off.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le préréglage Recommandé, plus Siri, l’analyse, les services publicitaires et Game Center désactivés."
          }
        }
      }
    },
    "Expanded Save and Print Panels": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zones Enregistrer et Imprimer développées"
          }
        }
      }
    },
    "Extension Change Warning": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerte de changement d’extension"
          }
        }
      }
    },
    "F1 to F12 work as function keys. Hold Fn for brightness and volume.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "F1 à F12 servent de touches de fonction. Maintenez Fn pour la luminosité et le volume."
          }
        }
      }
    },
    "Fast Key Repeat": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétition rapide des touches"
          }
        }
      }
    },
    "Faster Mission Control": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mission Control plus rapide"
          }
        }
      }
    },
    "Features": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctions"
          }
        }
      }
    },
    "Feedback Prompts": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandes de retours"
          }
        }
      }
    },
    "Files apps keep to load faster. They rebuild them as needed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers que les apps gardent pour se charger plus vite. Elles les recréent au besoin."
          }
        }
      }
    },
    "Find, download, and chat with local models in a window. Uses MLX on Apple silicon.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
