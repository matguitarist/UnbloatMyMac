    "Smart Quotes": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Guillemets intelligents"
          }
        }
      }
    },
    "Snap Windows to Edges": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancrer les fenêtres aux bords"
          }
        }
      }
    },
    "Snap windows to halves, thirds, and corners with keyboard shortcuts, like Windows-Arrow.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez les fenêtres en moitiés, tiers et coins avec des raccourcis clavier, comme Windows-Flèche."
          }
        }
      }
    },
    "Software update files Finder downloaded for your devices.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers de mise à jour téléchargés par le Finder pour vos appareils."
          }
        }
      }
    },
    "Solid backgrounds instead of glass, which saves GPU work on older Macs.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des fonds opaques au lieu du verre, ce qui allège le GPU des Mac plus anciens."
          }
        }
      }
    },
    "Spaces and full screen fade instead of slide.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Spaces et le plein écran apparaissent en fondu au lieu de glisser."
          }
        }
      }
    },
    "Spaces stay where you put them instead of reordering by use.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Spaces restent où vous les placez au lieu d’être réordonnés selon l’usage."
          }
        }
      }
    },
    "Speech to text from the command line, with Whisper models.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De la parole au texte en ligne de commande, avec les modèles Whisper."
          }
        }
      }
    },
    "Spotlight Indexing": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indexation Spotlight"
          }
        }
      }
    },
    "Spotlight Internet Results": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résultats Internet dans Spotlight"
          }
        }
      }
    },
    "Spotlight and Finder search stop finding files.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight et la recherche du Finder ne trouvent plus les fichiers."
          }
        }
      }
    },
    "Spotlight shows only results from this Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight n’affiche que les résultats de ce Mac."
          }
        }
      }
    },
    "Standard Function Keys": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touches de fonction standard"
          }
        }
      }
    },
    "Status Bar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre d’état"
          }
        }
      }
    },
    "Stop analytics, personalized ads, and the services that send usage data to Apple.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez l’analyse, les publicités personnalisées et les services qui envoient des données d’utilisation à Apple."
          }
        }
      }
    },
    "Stop macOS from changing what you type.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêchez macOS de modifier ce que vous tapez."
          }
        }
      }
    },
    "Stops Look Up from sending the words you select to Apple.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche Recherche d’envoyer à Apple les mots que vous sélectionnez."
          }
        }
      }
    },
    "Stops Safari from reporting ad clicks to advertisers, even anonymously.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche Safari de signaler les clics publicitaires aux annonceurs, même de façon anonyme."
          }
        }
      }
    },
    "Stops Spotlight from sending what you type to Apple for web suggestions.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche Spotlight d’envoyer ce que vous tapez à Apple pour des suggestions web."
          }
        }
      }
    },
    "Stops call screening, live translation, and call summaries.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête le filtrage des appels, la traduction en direct et les résumés d’appels."
          }
        }
      }
    },
    "Stops indexing every disk. Saves CPU and disk writes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête l’indexation de tous les disques. Économise processeur et écritures."
          }
        }
      }
    },
    "Stops recording which apps and websites you use.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête l’enregistrement des apps et sites que vous utilisez."
          }
        }
      }
    },
    "Stops scanning your photo library for faces, scenes, and text.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête l’analyse de votre photothèque à la recherche de visages, de scènes et de texte."
          }
        }
      }
    },
    "Stops sending diagnostics and usage data to Apple and app developers.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête l’envoi de diagnostics et de données d’utilisation à Apple et aux développeurs."
          }
        }
      }
    },
    "Stops sending what you type in the address bar to Apple and your search engine.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête l’envoi de ce que vous tapez dans la barre d’adresse à Apple et à votre moteur de recherche."
          }
        }
      }
    },
    "Stops sharing Siri and dictation recordings with Apple.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête le partage des enregistrements de Siri et de Dictée avec Apple."
          }
        }
      }
    },
    "Stops the Dock icon from pulsing while an app opens.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’icône du Dock ne pulse plus pendant l’ouverture d’une app."
          }
        }
      }
    },
    "Stops the Game Center service and its sign-in pop-ups.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête le service Game Center et ses fenêtres de connexion."
          }
        }
      }
    },
    "Stops the Siri knowledge, actions, and voice services.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête les services de connaissance, d’actions et de voix de Siri."
          }
        }
      }
    },
    "Stops the Tips app from sending notifications.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche l’app Astuces d’envoyer des notifications."
          }
        }
      }
    },
    "Stops the ad attribution and promoted content services.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête les services d’attribution publicitaire et de contenu sponsorisé."
          }
        }
      }
    },
    "Stops the agent that asks for feedback and collects logs for Apple.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête l’agent qui demande des retours et collecte des journaux pour Apple."
          }
        }
      }
    },
    "Stops the agents that collect input, location, and app analytics.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête les agents qui collectent des données de saisie, de localisation et d’apps."
          }
        }
      }
    },
    "Stops the service that looks up what is on screen.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête le service qui analyse ce qui est à l’écran."
          }
        }
      }
    },
    "Stops the service that reads mail and messages to suggest contacts and events.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête le service qui lit e-mails et messages pour suggérer contacts et événements."
          }
        }
      }
    },
    "Stops the services that index your mail, messages, and photos for Apple Intelligence.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête les services qui indexent vos e-mails, messages et photos pour Apple Intelligence."
          }
        }
      }
    },
    "Stops the services that run Apple Intelligence models.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête les services qui exécutent les modèles d’Apple Intelligence."
          }
        }
      }
    },
    "Straight quotes stay straight, which matters for code.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les guillemets droits restent droits, ce qui compte pour le code."
          }
        }
      }
    },
    "Summaries": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résumés"
          }
        }
      }
    },
    "Summaries and smart replies in Mail.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résumés et réponses intelligentes dans Mail."
          }
        }
      }
    },
    "Switch between windows, not just apps, with previews, like Alt-Tab on Windows.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez d’une fenêtre à l’autre, pas seulement d’une app à l’autre, avec des aperçus, comme Alt-Tab sous Windows."
          }
