    "The Siri knowledge, actions, and voice services that run in the background.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les services de connaissances, d’actions et de voix de Siri qui tournent en arrière-plan."
          }
        }
      }
    },
    "The Tips app sends notifications.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app Astuces envoie des notifications."
          }
        }
      }
    },
    "The ad attribution and promoted content services.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les services d’attribution publicitaire et de contenu sponsorisé."
          }
        }
      }
    },
    "The address bar shows the whole address, so you can see where you really are.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d’adresse affiche l’adresse entière, pour savoir où vous êtes vraiment."
          }
        }
      }
    },
    "The admin command failed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande administrateur a échoué."
          }
        }
      }
    },
    "The agent that asks for feedback and collects logs for Apple.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent qui demande votre avis et collecte des journaux pour Apple."
          }
        }
      }
    },
    "The command failed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande a échoué."
          }
        }
      }
    },
    "The engine behind many local AI apps, as command line tools and a server.": {
      "localizations": {
        "fr": {
