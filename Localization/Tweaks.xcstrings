            "value": "Services d’arrière-plan de Siri"
          }
        }
      }
    },
    "Siri Suggestions in Apps": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestions de Siri dans les apps"
          }
        }
      }
    },
    "Siri and Spotlight know less about your data.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri et Spotlight en savent moins sur vos données."
          }
        }
      }
    },
    "Siri, “Hey Siri”, and the Siri menu bar icon.": {
      "localizations": {
