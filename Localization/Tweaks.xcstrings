            "state": "translated",
            "value": "Des fonds opaques au lieu du verre, ce qui allège le GPU des Mac plus anciens."
          }
        }
      }
    },
    "Spaces and full screen fade instead of slide.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Spaces et le plein écran apparaissent en fondu au lieu de glisser."
          }
        }
      }
    },
    "Spaces stay where you put them instead of reordering by use.": {
      "localizations": {
        "fr": {
          "stringUnit": {
